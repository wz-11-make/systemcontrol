android_app {
    name: "Agent",
    srcs: ["src/**/*.java"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    static_libs: [
        "android.system.agent.control-java",
    ],
    optimize: {
        enabled: false,
    },
}
